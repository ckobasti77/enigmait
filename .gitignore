showcase/captures/

# showcase — dnevnici nocnog lanca i screenshotovi za review. Oboje se
# regenerise pokretanjem lanca ponovo, pa su artefakt procesa, ne kod.
showcase/logs/
showcase/review/

# playwright mcp session logs
.playwright-mcp/

# Claude Code — licna podesavanja masine (permission allowlist).
# Deljena konfiguracija (.claude/rules, .claude/skills, CLAUDE.md) SE komituje.
.claude/settings.local.json

# Blender
blender/renders/
blender/scenes/_versions/
*.blend1
*.blend2
blender/refs/
